# REQUIRED on Vercel (Production + Preview as appropriate)
APP_ENV=production
DEBUG=false
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Auth / API
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALLOW_REGISTRATION=false
RATE_LIMIT_ENABLED=true

# Same-origin UI + API needs no cross-origin browser access by default.
# Add comma-separated origins only if you intentionally host another frontend.
CORS_ORIGINS=https://your-domain.example,https://your-project.vercel.app
LOG_LEVEL=INFO

# Serverless-safe SQLAlchemy pool defaults. Tune only if your DB plan permits it.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=10
