# Copy this file to .env before public deployment.
APP_ENV=production
DEBUG=false
APP_PORT=3000

MYSQL_DATABASE=fashioncart
MYSQL_USER=fashioncart
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Same-origin Nginx proxy means this is mainly for direct API/dev access.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Abuse protection / access control
RATE_LIMIT_ENABLED=true
# Set to false on a public demo to stop strangers creating accounts
ALLOW_REGISTRATION=true

# Database pool (safe defaults for Vercel/serverless; Docker may tune upward)
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=10
