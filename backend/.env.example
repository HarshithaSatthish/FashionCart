APP_ENV=development
DEBUG=true
DATABASE_URL=mysql+pymysql://fashioncart:fashioncart@db:3306/fashioncart
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
ALLOW_REGISTRATION=true
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=10
